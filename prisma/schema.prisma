// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum SettingKind {
  ASSET_MODEL
  CATEGORY
  MANUFACTURER
  SUPPLIER
  DEPARTMENT
  LOCATION
  COMPANY
}

model User {
  id                    Int      @id @default(autoincrement())
  slug                  String   @unique @default(uuid())
  email                 String   @unique
  passwordHash          String
  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tasks         Task[]  @relation("TaskOwner")
  createdTasks  Task[]  @relation("TaskCreator")
  updatedTasks  Task[]  @relation("TaskUpdater")
  notifications Notification[]
}

model Task {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  slug        String   @unique
  space       String?
  workType    String?
  status      String   @default("To do")
  summary     String
  description String?
  assignee    String?
  reporter    String?
  priority    String?
  labels      String?
  dueDate     DateTime?
  startDate   DateTime?
  category    String?
  team        String?
  subtasks    Json?
  userId      Int
  createdBy   Int
  updatedBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User @relation("TaskOwner", fields: [userId], references: [id])
  creator  User @relation("TaskCreator", fields: [createdBy], references: [id])
  updater  User @relation("TaskUpdater", fields: [updatedBy], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model SettingRecord {
  id          Int         @id @default(autoincrement())
  kind        SettingKind
  name        String
  slug        String
  code        String?
  description String?
  isActive    Boolean     @default(true)
  createdBy   Int?
  updatedBy   Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([kind, slug])
  @@unique([kind, name])
  @@index([kind, isActive])
}

model Company {
  id          Int          @id @default(autoincrement())
  slug        String       @unique @default(uuid())
  name        String
  phone       String?
  fax         String?
  email       String?
  logo        String?
  notes       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  locations   Location[]
  departments Department[]
}

model Category {
  id                  Int          @id @default(autoincrement())
  slug                String       @unique @default(uuid())
  name                String
  type                String       // Asset, Accessory, Consumable, Component, License
  eula                String?      @db.LongText
  useDefaultEula      Boolean      @default(true)
  requireConfirmation Boolean      @default(false)
  emailNotification   Boolean      @default(false)
  image               String?
  notes               String?      @db.Text
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  assetModels         AssetModel[]
}

model Manufacturer {
  id                Int          @id @default(autoincrement())
  slug              String       @unique @default(uuid())
  name              String
  url               String?
  supportUrl        String?
  warrantyLookupUrl String?
  supportPhone      String?
  supportEmail      String?
  image             String?
  notes             String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  assetModels       AssetModel[]
}

model Supplier {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @default(uuid())
  name        String
  contactName String?
  phone       String?
  fax         String?
  email       String?
  url         String?
  address     String?
  city        String?
  state       String?
  country     String?
  zip         String?
  image       String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Location {
  id        Int      @id @default(autoincrement())
  slug      String   @unique @default(uuid())
  name      String
  parentId  Int?
  parent    Location? @relation("LocationHierarchy", fields: [parentId], references: [id])
  children  Location[] @relation("LocationHierarchy")
  managerId Int?
  companyId Int?
  company   Company?  @relation(fields: [companyId], references: [id])
  phone     String?
  fax       String?
  currency  String?
  address   String?
  address2  String?
  city      String?
  state     String?
  country   String?
  zip       String?
  image     String?
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  departments Department[]
}

model Department {
  id         Int      @id @default(autoincrement())
  slug       String   @unique @default(uuid())
  name       String
  companyId  Int?
  company    Company? @relation(fields: [companyId], references: [id])
  phone      String?
  fax        String?
  managerId  Int?
  locationId Int?
  location   Location? @relation(fields: [locationId], references: [id])
  image      String?
  notes      String?   @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model AssetModel {
  id                 Int          @id @default(autoincrement())
  slug               String       @unique @default(uuid())
  name               String
  categoryId         Int
  category           Category     @relation(fields: [categoryId], references: [id])
  manufacturerId     Int
  manufacturer       Manufacturer @relation(fields: [manufacturerId], references: [id])
  modelNumber        String?
  depreciationId     Int?
  minQty             Int?
  requireSerialNumber Boolean      @default(false)
  eolMonths          Int?
  fieldsetId         Int?
  image              String?
  notes              String?      @db.Text
  isRequestable      Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model StatusLabel {
  id        Int      @id @default(autoincrement())
  slug      String   @unique @default(uuid())
  name      String
  type      String   // Deployable, Undeployable, Archived, Pending
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
